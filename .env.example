PUBBURI_DB_NAME=
PUBBURI_DB_USER=
PUBBURI_DB_PASSWORD=
PUBBURI_DB_ROOT_PASSWORD=
PUBBURI_DB_PORT=3306
PUBBURI_DB_URL=
PUBBURI_SERVER_PORT=9987
PUBBURI_FRONTEND_PORT=5173
PUBBURI_RECOMMENDATION_PORT=8000
PUBBURI_RECOMMENDATION_BASE_URL=http://127.0.0.1:8000
# Optional explicit compose.search.yml engine; the default local stack does not start it.
PUBBURI_SEARCH_PORT=9200
# Public /products opt-in. Disabled keeps the existing database-only runtime.
PUBBURI_SEARCH_ENABLED=false
PUBBURI_SEARCH_ENDPOINT=http://127.0.0.1:9200
PUBBURI_SEARCH_INDEX=pubburi-products-v1-live
PUBBURI_LOG_LEVEL=INFO

# Optional Recommendation checked container-DEMO bundle; blank never sends the legacy catalog to B1.
PUBBURI_CONTENT_CATALOG_PATH=
PUBBURI_CONTENT_CATALOG_SHA256=

# Explicit family-browse DEMO only; never approves a sellable SKU/container.
PUBBURI_CONTENT_FAMILY_BROWSE_DEMO_ENABLED=false
