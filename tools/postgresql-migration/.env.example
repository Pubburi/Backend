# Rehearsal only. Actual credentials, token and public CA must stay ignored.
PUBBURI_PG_URL=jdbc:postgresql://127.0.0.1:54321/pubburi_pg_ci
PUBBURI_PG_DB_NAME=pubburi_pg_ci
PUBBURI_PG_USER=pubburi_pg_migrator
PUBBURI_PG_PASSWORD=replace-with-local-fixture-password
PUBBURI_PG_RUN_TOKEN=replace-with-unique-fixture-token
PUBBURI_PG_CA=.pubburi/pg-ca.pem
PUBBURI_PG_CONTAINER_ID=replace-with-owned-container-id
PUBBURI_PG_VALIDATION_LABEL=postgresql-schema-ci
PUBBURI_PG_MUTATING=1
PUBBURI_PG_IDENTITY_FILE=.pubburi/postgresql-identities.txt

# Separate read-only SOURCE copy. Never use the current development/user database.
PUBBURI_SOURCE_URL=jdbc:mysql://127.0.0.1:54322/source_snapshot_ci
PUBBURI_SOURCE_DB_NAME=source_snapshot_ci
PUBBURI_SOURCE_USER=source_reader
PUBBURI_SOURCE_PASSWORD=replace-with-source-reader-password
PUBBURI_SOURCE_TRUSTSTORE=.pubburi/source-truststore.p12
PUBBURI_SOURCE_TRUSTSTORE_PASSWORD=replace-with-truststore-password
PUBBURI_SOURCE_CONTAINER_ID=replace-with-owned-source-container-id
PUBBURI_SOURCE_VALIDATION_LABEL=source-snapshot-fixture
PUBBURI_SOURCE_RUN_TOKEN=replace-with-source-run-token
PUBBURI_SOURCE_WINDOW_UUID=00000000-0000-4000-8000-000000000001
PUBBURI_SOURCE_WRITES_STOPPED=1
PUBBURI_SOURCE_DATETIME_ZONE=UTC
PUBBURI_SOURCE_SNAPSHOT_DIR=.pubburi/source-export-unique

# Approved artifact only; do not infer current source quiescence from its hash.
PUBBURI_PG_IMPORT_WRITES_STOPPED=1
PUBBURI_PG_IMPORT_SHA256=replace-with-approved-snapshot-sha256
PUBBURI_PG_IMPORT_SOURCE_ID=00000000-0000-4000-8000-000000000001
PUBBURI_PG_IMPORT_WINDOW_UUID=00000000-0000-4000-8000-000000000001
