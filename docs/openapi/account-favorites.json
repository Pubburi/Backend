    }
  },
  "components": {
    "securitySchemes": {
      "Session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "price",
          "img",
          "abv",
          "orderCount"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "img": {
            "type": [
              "string",
              "null"
            ]
          },
          "abv": {
            "type": "number",
            "format": "float"
          },
          "orderCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FavoritePage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "total",
          "totalPages",
          "hasNext"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "FavoriteMembership": {
        "type": "object",
        "required": [
          "productId",
          "favorited"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "favorited": {
            "type": "boolean"
          }
        }
      },
      "PageEnvelope": {
        "type": "object",
        "required": [
          "data",
          "message",
          "error"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/FavoritePage"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "MembershipEnvelope": {
        "type": "object",
        "required": [
          "data",
          "message",
          "error"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/FavoriteMembership"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "data",
          "message",
          "error"
        ],
        "properties": {
          "data": {
            "type": "null"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "fields"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
