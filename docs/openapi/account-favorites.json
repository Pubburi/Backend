{
  "openapi": "3.1.0",
  "info": {
    "title": "Pubburi private account favorites increment",
    "version": "1.0.0",
    "description": "Self-only storage, including administrators. A saved relation is not real popularity, preference learning or purchase evidence. Opposing concurrent PUT/DELETE follow DB lock order, not client intent ordering."
  },
  "servers": [
    {
      "url": "http://localhost:9987"
    }
  ],
  "paths": {
    "/api/users/me/favorites": {
      "get": {
        "security": [
          {
            "Session": []
          }
        ],
        "operationId": "pageOwnFavorites",
        "description": "Private even for ADMIN. Current product fields; created_at DESC, product_id DESC. Active empty account differs from expired identity.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            },
            "description": "Values below 1 normalize to 1. Offset greater than int32 is 400."
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            },
            "description": "Values below 1 use 20; greater than 100 clamp to 100."
          }
        ],
        "responses": {
          "200": {
            "description": "Current-account page. No owner/epoch/timestamp added to existing product DTO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST: malformed ID, integer or pagination overflow.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: no current account incarnation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED. Unsupported method; no membership changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                },
                "description": "Supported methods for this route. Member route includes GET, PUT and DELETE."
              }
            }
          },
          "406": {
            "description": "NOT_ACCEPTABLE JSON envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT: related-data integrity failure, never a successful membership.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR. Unexpected DB failures are not empty favorites or success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me/favorites/{productId}": {
      "get": {
        "security": [
          {
            "Session": []
          }
        ],
        "operationId": "getOwnFavoriteState",
        "description": "No body or owner selector. Read only the current account incarnation. Active account with absent membership, missing or deleted product returns 200 false; expired account is 401. Does not reorder or create favorites.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current private membership, productId and favorited only. Missing or deleted product is false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST: malformed ID, integer or pagination overflow.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: no current account incarnation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED. Unsupported method; no membership changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                },
                "description": "Supported methods for this route. Member route includes GET, PUT and DELETE."
              }
            }
          },
          "406": {
            "description": "NOT_ACCEPTABLE JSON envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT: related-data integrity failure, never a successful membership.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR. Unexpected DB failures are not empty favorites or success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "put": {
        "security": [
          {
            "Session": []
          }
        ],
        "operationId": "putOwnFavorite",
        "description": "No request body or owner selector. Repeated PUT preserves original created_at and ordering.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Idempotent desired membership; productId and favorited only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST: malformed ID, integer or pagination overflow.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: no current account incarnation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED. Unsupported method; no membership changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                },
                "description": "Supported methods for this route. Member route includes GET, PUT and DELETE."
              }
            }
          },
          "406": {
            "description": "NOT_ACCEPTABLE JSON envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT: related-data integrity failure, never a successful membership.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR. Unexpected DB failures are not empty favorites or success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: product does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "Session": []
          }
        ],
        "operationId": "deleteOwnFavorite",
        "description": "No request body or owner selector. Absent membership or deleted product returns 200 false. No catalog recreation.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Idempotent desired membership; productId and favorited only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST: malformed ID, integer or pagination overflow.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: no current account incarnation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED. Unsupported method; no membership changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                },
                "description": "Supported methods for this route. Member route includes GET, PUT and DELETE."
              }
            }
          },
          "406": {
            "description": "NOT_ACCEPTABLE JSON envelope.",
            "content": {
